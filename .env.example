# Environment variables for Bricks Manager Docker deployment
# Copy this file to .env and customize the values

# Application Settings
SECRET_KEY=your-very-secure-secret-key-here-change-this-in-production
FLASK_ENV=production
FLASK_DEBUG=0

# Rebrickable API Configuration
REBRICKABLE_TOKEN=your-rebrickable-api-token-here

# Database Configuration (usually no need to change for Docker)
SQLALCHEMY_DATABASE_URI=sqlite:///data/instance/brick_manager.db

# Optional: Logging Level
LOG_LEVEL=INFO

# Optional for direct trusted-LAN access (restrict with a firewall)
# FLASK_RUN_HOST=0.0.0.0
# FLASK_RUN_PORT=5000

# Desktop client API (use the same strong random value in the client .env)
BRICK_MANAGER_CLIENT_API_KEY=